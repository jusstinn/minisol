# ── LLM ────────────────────────────────────────────────────────────────
# Required for the live agent. Without it (or when rate-limited) the app
# automatically falls back to the offline scripted demo agent.
OPENAI_API_KEY=
# The conversation model: tools, edits, replies. Fast and cheap. Default: gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini
# Optional stronger model that writes a new project's plan (one compact call, in parallel with the
# reply). Unset → the conversation model writes it. E.g. gpt-5.5.
OPENAI_PLAN_MODEL=
OPENAI_PLAN_REASONING_EFFORT=low
# OpenAI's own limits per model (see the x-ratelimit headers / your org's limits page). The app
# stays under them: near a per-minute limit it waits a few seconds; at a daily one it falls back.
# Empty = not limited here.
OPENAI_RPM=
OPENAI_TPM=
OPENAI_RPD=
OPENAI_PLAN_RPM=
OPENAI_PLAN_TPM=
OPENAI_PLAN_RPD=
# none | minimal | low | medium | high (reasoning models only)
OPENAI_REASONING_EFFORT=low
# Set to "scripted" to always use the offline demo agent (no LLM calls at all).
AGENT_MODE=

# ── White-label tenant ─────────────────────────────────────────────────
# demo (neutral "Atelier") | hornbach | brico — or pass ?retailer=<id> in the URL.
TENANT=demo
NEXT_PUBLIC_TENANT=demo

# ── Data sources ───────────────────────────────────────────────────────
# demo (default) | walletloop (real WalletLoop members/offers, demo catalogue & stock)
DATA_SOURCE=demo
WALLETLOOP_API_URL=
WALLETLOOP_API_KEY=
WALLETLOOP_PROGRAM_ID=

# ── Production entry: signed pass links ────────────────────────────────
# Unset (default) = the demo: anyone can pick one of the demo members.
# 1 = product mode: the member comes only from a signed link on their wallet pass
# (?t=<token>, exchanged for an httpOnly session cookie); every API route ignores the
# memberId the browser sends and answers 401 without a valid session.
REQUIRE_PASS_LINK=
# HMAC-SHA256 secret shared with the WalletLoop pass backend that signs the links.
# At least 32 characters; required when REQUIRE_PASS_LINK=1. Generate: openssl rand -base64 48
PASS_LINK_SECRET=
# Public base URL used by scripts/make-pass-link.ts (default http://localhost:3100).
PUBLIC_BASE_URL=
# Longest a pass link may still be valid for, in hours (default 24); longer links are refused.
PASS_LINK_MAX_HOURS=
# 1 = each link works once (only when the pass backend mints a fresh link per tap; needs the store).
PASS_LINK_SINGLE_USE=

# ── Abuse protection / AI budget (src/lib/budget.ts) ───────────────────
# Over any limit a chat turn falls back to the offline agent (no error, no model call).
# Limits apply per member (pass link) → per sign-in session (one per device) → per IP, plus a looser
# per-IP cap. Seconds between two live turns of the same visitor:
LLM_COOLDOWN_S=3
# Live-AI turns per visitor per 10 minutes (default 12; 40 behind the site sign-in), and per day.
LLM_TURNS_PER_10_MIN=12
LLM_TURNS_PER_DAY=60
# Live-AI turns per member per day (product mode only: the member comes from the signed link).
LLM_MEMBER_TURNS_PER_DAY=40
# Live-AI turns for the whole deployment per day — the hard backstop. ~4 model requests per turn.
LLM_DAILY_TURNS=400
# Tokens per day (input + output): for the deployment, and per member in product mode.
LLM_DAILY_TOKENS=8000000
LLM_MEMBER_TOKENS_PER_DAY=800000
# Output-token ceiling per model request (reasoning included).
LLM_MAX_OUTPUT_TOKENS=2500
# "Read the sizes with AI" on an uploaded plan: per visitor per 10 minutes, and per day overall.
PLAN_READS_PER_10_MIN=6
PLAN_READS_PER_DAY=60
# Shared counters so the limits hold across all serverless instances (Upstash Redis, free tier,
# via the Vercel Marketplace; Vercel KV's KV_REST_API_URL/_TOKEN work too). Without them the
# counters are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# In Vercel production live AI stays off without that store; 1 = accept per-instance counters anyway.
ALLOW_MEMORY_BUDGET=
# Signs the chat history kept in the browser (default: derived from PASS_LINK_SECRET or OPENAI_API_KEY).
HISTORY_SECRET=

# ── Anonymous usage events (see README → Usage events) ─────────────────
# off = send nothing from the browser.
NEXT_PUBLIC_USAGE=
# off = drop events on the server. Default: one "[usage] {json}" line per event in the log.
USAGE_SINK=
# Optional: also POST each batch ({ events: [...] }) here, e.g. WalletLoop analytics.
USAGE_WEBHOOK_URL=

# ── Site sign-in (src/lib/siteLogin.ts) ────────────────────────────────
# Set both to put the whole site behind a user name and password (pages → /login, APIs → 401).
# With it on, live AI also runs in production without the Upstash store (only invited people get in).
SITE_LOGIN_USER=
SITE_LOGIN_PASSWORD=
# How long a sign-in lasts, in days (default 7, max 30). Changing the password signs everyone out.
SITE_LOGIN_DAYS=
