# ── LLM ────────────────────────────────────────────────────────────────
# Required for the live agent. Without it (or when rate-limited) the app
# automatically falls back to the offline scripted demo agent.
OPENAI_API_KEY=
# Default: gpt-5.4-mini (fast, good tool use). Any Responses-API model works.
OPENAI_MODEL=gpt-5.4-mini
# none | minimal | low | medium | high (reasoning models only)
OPENAI_REASONING_EFFORT=low
# Set to "scripted" to always use the offline demo agent (no LLM calls at all).
AGENT_MODE=

# ── White-label tenant ─────────────────────────────────────────────────
# demo (neutral "Atelier") | hornbach | brico — or pass ?retailer=<id> in the URL.
TENANT=demo
NEXT_PUBLIC_TENANT=demo

# ── Data sources ───────────────────────────────────────────────────────
# demo (default) | walletloop (real WalletLoop members/offers, demo catalogue & stock)
DATA_SOURCE=demo
WALLETLOOP_API_URL=
WALLETLOOP_API_KEY=
WALLETLOOP_PROGRAM_ID=

# ── Production entry: signed pass links ────────────────────────────────
# Unset (default) = the demo: anyone can pick one of the demo members.
# 1 = product mode: the member comes only from a signed link on their wallet pass
# (?t=<token>, exchanged for an httpOnly session cookie); every API route ignores the
# memberId the browser sends and answers 401 without a valid session.
REQUIRE_PASS_LINK=
# HMAC-SHA256 secret shared with the WalletLoop pass backend that signs the links.
# At least 32 characters; required when REQUIRE_PASS_LINK=1. Generate: openssl rand -base64 48
PASS_LINK_SECRET=
# Public base URL used by scripts/make-pass-link.ts (default http://localhost:3100).
PUBLIC_BASE_URL=

# ── Abuse protection ───────────────────────────────────────────────────
# Live-AI turns per visitor per 10 minutes before falling back to the offline agent.
LLM_TURNS_PER_10_MIN=12
# "Read the sizes with AI" on an uploaded plan, per visitor per 10 minutes (default 6).
PLAN_READS_PER_10_MIN=6

# ── Anonymous usage events (see README → Usage events) ─────────────────
# off = send nothing from the browser.
NEXT_PUBLIC_USAGE=
# off = drop events on the server. Default: one "[usage] {json}" line per event in the log.
USAGE_SINK=
# Optional: also POST each batch ({ events: [...] }) here, e.g. WalletLoop analytics.
USAGE_WEBHOOK_URL=
